# application-local.yml.example
# 이 파일을 application-local.yml 로 복사한 뒤 값을 채워서 사용하세요.
# application-local.yml 은 .gitignore 에 포함되어 있어 절대 커밋되지 않습니다.

spring:
  datasource:
    url: jdbc:mysql://localhost:3307/showme_v2?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
    username: showme
    password: your_db_password_here

jwt:
  secret: your-jwt-secret-key-must-be-at-least-32-characters-long

cloud:
  aws:
    s3:
      bucket: your-s3-bucket-name
    region:
      static: ap-northeast-2

firebase:
  enabled: false
  service-account-path:
